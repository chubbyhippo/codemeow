{
  "name": "codemeow",
  "displayName": "codemeow",
  "description": "Meow-style modal editing for VS Code and VSCodium: NORMAL / INSERT / MOTION / KEYPAD states, selection-first commands, the char-thing table, digit expand with hints, grab / swap-grab / sync-grab, and a beacon approximation on native multiple cursors. The whole keymap lives in a bundled .codemeowrc (QWERTY by default, every key rebindable); ~/.codemeowrc overrides it entry by entry. Disable VSCodeVim while this is enabled — both intercept typing.",
  "version": "0.1.0",
  "publisher": "chubbyhippo",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/chubbyhippo/codemeow.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Keymaps",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/vscode/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codemeow.reloadRc",
        "title": "Reload .codemeowrc",
        "category": "codemeow",
        "icon": "$(refresh)"
      },
      {
        "command": "codemeow.editRc",
        "title": "Edit .codemeowrc",
        "category": "codemeow"
      },
      {
        "command": "codemeow.cheatsheet",
        "title": "Meow Cheatsheet",
        "category": "codemeow"
      },
      {
        "command": "codemeow.commandIds",
        "title": "Find Command Id",
        "category": "codemeow"
      },
      {
        "command": "codemeow.keypad",
        "title": "Meow Keypad",
        "category": "codemeow"
      },
      {
        "command": "codemeow.chord",
        "title": "Emacs Chord",
        "category": "codemeow"
      },
      {
        "command": "codemeow.hostKey",
        "title": "Host Key",
        "category": "codemeow"
      },
      {
        "command": "codemeow.windmoveLeft",
        "title": "Windmove Left",
        "category": "codemeow"
      },
      {
        "command": "codemeow.windmoveRight",
        "title": "Windmove Right",
        "category": "codemeow"
      },
      {
        "command": "codemeow.windmoveUp",
        "title": "Windmove Up",
        "category": "codemeow"
      },
      {
        "command": "codemeow.windmoveDown",
        "title": "Windmove Down",
        "category": "codemeow"
      },
      {
        "command": "codemeow.aceWindow",
        "title": "Ace Window",
        "category": "codemeow"
      },
      {
        "command": "codemeow.aceClick",
        "title": "Ace Click",
        "category": "codemeow"
      },
      {
        "command": "codemeow.aceResize",
        "title": "Ace Resize",
        "category": "codemeow"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codemeow.reloadRc",
          "when": "resourceFilename == .codemeowrc && codemeow.rcChanged",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "codemeow.chord",
          "when": "false"
        },
        {
          "command": "codemeow.hostKey",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "key": "escape",
        "command": "codemeow.escape",
        "when": "editorTextFocus && codemeow.active && !suggestWidgetVisible && !findWidgetVisible && !parameterHintsVisible && !renameInputVisible && !inSnippetMode"
      },
      {
        "key": "space",
        "command": "codemeow.hostKey",
        "args": "space",
        "when": "listFocus && !inputFocus && !editorTextFocus && !terminalFocus && codemeow.active && codemeow.host.space"
      },
      {
        "key": "alt+;",
        "command": "codemeow.hostKey",
        "args": "alt+;",
        "when": "editorTextFocus && codemeow.active && !codemeow.normal && codemeow.host.altSemicolon"
      },
      {
        "key": "shift+left",
        "command": "codemeow.hostKey",
        "args": "shift+left",
        "when": "editorTextFocus && codemeow.active && codemeow.host.shiftLeft"
      },
      {
        "key": "shift+right",
